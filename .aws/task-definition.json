{
  "family": "EnterpriseAIAgentTaskDefinition",
  "taskRoleArn": "arn:aws:iam::875243385163:role/EnterpriseAIAgentECSTaskRole",
  "executionRoleArn": "arn:aws:iam::875243385163:role/EnterpriseAIAgentECSExecutionRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "enterprise-ai-agent",
      "image": "875243385163.dkr.ecr.ap-southeast-2.amazonaws.com/enterprise-ai-agent:1d8c46bbf0776342411d9337307a8e255499555e",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8501,
          "hostPort": 8501,
          "protocol": "tcp",
          "name": "enterprise-ai-agent-8501-tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "KNOWLEDGE_BASE_TOP_K",
          "value": "5"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-southeast-2"
        },
        {
          "name": "BEDROCK_GUARDRAIL_VERSION",
          "value": "DRAFT"
        },
        {
          "name": "BEDROCK_KNOWLEDGE_BASE_ID",
          "value": "KD4BYVZAVV"
        },
        {
          "name": "TOOL_TIMEOUT_SECONDS",
          "value": "8"
        },
        {
          "name": "MAX_AGENT_ITERATIONS",
          "value": "5"
        },
        {
          "name": "BEDROCK_KNOWLEDGE_BASE_REGION",
          "value": "us-east-1"
        },
        {
          "name": "BEDROCK_GUARDRAIL_ID",
          "value": "hosqnax7ctup"
        },
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "amazon.nova-lite-v1:0"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "ALPHA_VANTAGE_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:875243385163:secret:enterprise-ai-agent/alpha-vantage-api-key-SvVrw5"
        },
        {
          "name": "OPENWEATHER_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:875243385163:secret:enterprise-ai-agent/openweather-api-key-WD6pfw"
        },
        {
          "name": "TAVILY_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:875243385163:secret:enterprise-ai-agent/tavily-api-key-qzhno3"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/enterprise-ai-agent",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3)\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "systemControls": []
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048"
}